{
  "name": "server-status-exposure",
  "base": "https://localizestaging.com",
  "steps": [
    {
      "id": "fetch-server-status",
      "path": "/server-status",
      "expect": { "status": 200, "contains": "Apache Server Status" },
      "note": "Apache mod_status exposed — reveals worker PIDs, vhosts, request history"
    },
    {
      "id": "fetch-actuator-info",
      "path": "/actuator/info",
      "expect": { "status": 200 },
      "note": "Spring Boot actuator info exposed"
    }
  ],
  "impact": {
    "step": "fetch-server-status",
    "contains": "Server Version"
  }
}
